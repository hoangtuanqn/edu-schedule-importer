PORT=3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khớp Authorized redirect URI trong Google Console
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# URL iCal của LMS: LMS > Calendar > Export calendar > Get calendar URL
LMS_ICAL_URL=
DB_PATH=data/app.db

# --- Gửi email thông báo khi có biến động (để trống SMTP_PASS = tắt) ---
# Gmail: bật xác minh 2 bước, rồi tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Email nhận thông báo (mặc định = SMTP_USER)
NOTIFY_TO=

# Mã bí mật cho userscript FAP gửi lịch vào server; tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IMPORT_TOKEN=

# --- Dọn dẹp cho nhẹ máy (0 = không xóa) ---
# Xóa file log (logs/sync-*.log) không được ghi trong ngần này ngày
LOG_RETENTION_DAYS=7
# Xóa lịch sử các lần chạy trong DB cũ hơn ngần này ngày
HISTORY_RETENTION_DAYS=90
